{
  "primitive": {
    "paper": "#fffefb",
    "canvas": "#f8f7f4",
    "stone": "#efeee9",
    "line": "#dfdfd7",
    "ink": "#242923",
    "muted": "#656b61",
    "fieldLine": "#808a7b",
    "apricot": "#f4d8b7",
    "clay": "#71472d",
    "forest": "#256044",
    "red": "#a1352d",
    "softRed": "#fbe8e3",
    "softGreen": "#e9efe3",
    "softBlue": "#e5edf1",
    "blue": "#375d70",
    "softPurple": "#efe8f1",
    "purple": "#695074",
    "night": "#191d1a",
    "darkSurface": "#222823",
    "darkRaised": "#2c332d",
    "darkLine": "#485149",
    "lightInk": "#eeeee5",
    "lightMuted": "#b6c1b4"
  },
  "shared": {
    "font-body": "'Segoe UI Variable', 'Microsoft YaHei UI', 'PingFang SC', sans-serif",
    "font-code": "'Cascadia Code', Consolas, monospace",
    "text-xs": "12px",
    "text-sm": "13px",
    "text-base": "14px",
    "text-md": "16px",
    "text-lg": "20px",
    "text-xl": "28px",
    "text-display": "36px",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-10": "40px",
    "space-12": "48px",
    "space-16": "64px",
    "radius-sm": "6px",
    "radius-md": "10px",
    "radius-lg": "16px",
    "radius-pill": "999px",
    "stroke": "1px",
    "control-height": "44px",
    "icon-size": "20px",
    "sidebar-width": "220px",
    "content-width": "1200px",
    "dialog-width": "660px",
    "line-body": "1.7",
    "motion-fast": "160ms",
    "shadow-dialog": "0 24px 80px #00000033"
  },
  "themes": {
    "light": {
      "bg": "@canvas",
      "surface": "@paper",
      "raised": "@stone",
      "border": "@line",
      "field-border": "@fieldLine",
      "text": "@ink",
      "muted": "@muted",
      "action": "@ink",
      "action-text": "@paper",
      "focus": "@forest",
      "success": "@forest",
      "danger": "@red",
      "danger-bg": "@softRed",
      "feature": "@apricot",
      "feature-text": "@ink",
      "feature-muted": "@clay",
      "green-bg": "@softGreen",
      "green-text": "@forest",
      "blue-bg": "@softBlue",
      "blue-text": "@blue",
      "purple-bg": "@softPurple",
      "purple-text": "@purple",
      "illustration-bg": "@paper",
      "illustration-text": "@ink",
      "illustration-muted": "@muted",
      "illustration-line": "@stone",
      "backdrop": "@ink"
    },
    "dark": {
      "bg": "@night",
      "surface": "@darkSurface",
      "raised": "@darkRaised",
      "border": "@darkLine",
      "field-border": "@lightMuted",
      "text": "@lightInk",
      "muted": "@lightMuted",
      "action": "@lightInk",
      "action-text": "@night",
      "focus": "@apricot",
      "success": "@lightMuted",
      "danger": "@softRed",
      "danger-bg": "@red",
      "feature": "@apricot",
      "feature-text": "@ink",
      "feature-muted": "@clay",
      "green-bg": "@darkRaised",
      "green-text": "@lightMuted",
      "blue-bg": "@darkRaised",
      "blue-text": "@lightInk",
      "purple-bg": "@darkRaised",
      "purple-text": "@lightInk",
      "illustration-bg": "@paper",
      "illustration-text": "@ink",
      "illustration-muted": "@muted",
      "illustration-line": "@stone",
      "backdrop": "@ink"
    }
  }
}
